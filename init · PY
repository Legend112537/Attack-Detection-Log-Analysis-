"""
Log Parsers Module
"""

from .apache_parser import ApacheParser
from .nginx_parser import NginxParser
from .syslog_parser import SyslogParser
from .json_parser import JsonParser


class LogParser:
    """Unified log parser that delegates to format-specific parsers."""

    PARSERS = {
        "apache": ApacheParser,
        "nginx": NginxParser,
        "combined": ApacheParser,  # Combined format is same as Apache
        "syslog": SyslogParser,
        "json": JsonParser,
    }

    def __init__(self, log_format: str = "apache"):
        if log_format not in self.PARSERS:
            raise ValueError(f"Unsupported format: {log_format}. Choose from {list(self.PARSERS.keys())}")
        self._parser = self.PARSERS[log_format]()

    def parse_file(self, filepath: str):
        return self._parser.parse_file(filepath)

    def parse_line(self, line: str):
        return self._parser.parse_line(line)


__all__ = ["LogParser", "ApacheParser", "NginxParser", "SyslogParser", "JsonParser"]


from typing import List, Optional
from ..utils.alert import LogEntry, Alert
from .all_detectors import (
    SQLInjectionDetector, XSSDetector, PathTraversalDetector,
    CommandInjectionDetector, BruteForceDetector, DDoSDetector,
    ScannerDetector, UserAgentDetector,
)


class AttackDetector:
    def __init__(self, rules_file: Optional[str] = None, threshold: int = 5):
        self.detectors = [
            SQLInjectionDetector(),
            XSSDetector(),
            PathTraversalDetector(),
            CommandInjectionDetector(),
            UserAgentDetector(),
            BruteForceDetector(threshold=threshold),
            DDoSDetector(threshold=threshold * 80),
            ScannerDetector(threshold=threshold),
        ]

    def analyze(self, entries: List[LogEntry]) -> List[Alert]:
        all_alerts: List[Alert] = []
        for det in self.detectors:
            try:
                all_alerts.extend(det.detect(entries))
            except Exception as ex:
                print(f"[WARN] {det.__class__.__name__}: {ex}")
        order = {"CRITICAL": 4, "HIGH": 3, "MEDIUM": 2, "LOW": 1}
        all_alerts.sort(key=lambda a: order.get(a.severity, 0), reverse=True)
        return all_alerts
