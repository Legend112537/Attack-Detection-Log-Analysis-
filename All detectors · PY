import re
from collections import defaultdict
from datetime import timedelta
from typing import List
from urllib.parse import unquote
from ..utils.alert import LogEntry, Alert

# ─── helpers ──────────────────────────────────────────────────────────────────

def _max_window(entries, seconds):
    timed = sorted([e for e in entries if e.timestamp], key=lambda e: e.timestamp)
    if not timed:
        return len(entries)
    win = timedelta(seconds=seconds)
    best = 0
    for i, e in enumerate(timed):
        cnt = sum(1 for f in timed[i:] if f.timestamp - e.timestamp <= win)
        if cnt > best:
            best = cnt
    return best

# ─── SQL Injection ─────────────────────────────────────────────────────────────

_SQL = [
    (re.compile(r"union[\s+%20]+select", re.I),                         "Union-based SQLi",          "CRITICAL"),
    (re.compile(r"(sleep|benchmark|waitfor\s+delay|pg_sleep)\s*\(", re.I), "Time-based Blind SQLi",  "CRITICAL"),
    (re.compile(r"xp_cmdshell|xp_regread|sp_oacreate", re.I),           "MSSQL procedure abuse",     "CRITICAL"),
    (re.compile(r"load_file\s*\(|into\s+(outfile|dumpfile)", re.I),     "MySQL file read/write",     "CRITICAL"),
    (re.compile(r";\s*(select|insert|update|delete|drop|exec)", re.I),  "Stacked query SQLi",        "HIGH"),
    (re.compile(r"(select|insert|update|delete|drop|truncate|exec)\s*[\(%]", re.I), "SQL keyword",  "HIGH"),
    (re.compile(r"(--|#|/\*|\*/)(\s|%20|$)", re.I),                     "SQL comment",               "MEDIUM"),
    (re.compile(r"'\s*(or|and)\s*('|\d|true|false)", re.I),             "Boolean SQLi",              "MEDIUM"),
]

class SQLInjectionDetector:
    def detect(self, entries: List[LogEntry]) -> List[Alert]:
        alerts = []
        for e in entries:
            if not e.url: continue
            decoded = unquote(unquote(e.url))
            for pat, tech, sev in _SQL:
                if pat.search(decoded):
                    alerts.append(Alert(
                        attack_type="SQL Injection", ip=e.ip, severity=sev,
                        description=f"{tech} in request URL",
                        timestamp=e.timestamp, url=e.url, method=e.method,
                        status_code=e.status_code, user_agent=e.user_agent, raw_line=e.raw_line,
                    ))
                    break
        return alerts

